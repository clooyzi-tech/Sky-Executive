# ==============================================================================
# Hotel Sky Executive - Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & Domain Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Email Service (Nodemailer SMTP Configuration)
# Used for Contact Form submissions and Chatbot Assistant service requests.
# ------------------------------------------------------------------------------

# SMTP Server details (Default: Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender credentials:
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Factor Authentication enabled)
SMTP_USER=help.skyexecutive@gmail.com
SMTP_PASS=your-16-character-gmail-app-password

# Optional Custom From Address
SMTP_FROM="Hotel Sky Executive" <help.skyexecutive@gmail.com>

# Destination email for inquiries and guest requests
STAFF_RECEIVER_EMAIL=help.skyexecutive@gmail.com
CONTACT_RECEIVER_EMAIL=help.skyexecutive@gmail.com

# ------------------------------------------------------------------------------
# 3. Development / Simulation Flag
# When set to true (or when SMTP credentials are not yet entered in dev mode),
# enquiries will be logged cleanly to the terminal console instead of failing.
# ------------------------------------------------------------------------------
EMAIL_DEV_MODE=false
