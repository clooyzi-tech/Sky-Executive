# ========================================================
# Nodemailer SMTP Configuration (liv.inn Contact Form)
# ========================================================
# Copy this file to .env.local and fill in your actual values:
# cp .env.example .env.local

# SMTP Provider Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailgun.org, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP Port: 465 for SSL/TLS, or 587 for STARTTLS
SMTP_PORT=465

# Set to true for port 465, or false for port 587
SMTP_SECURE=true

# Sender Email / Username
# If using Gmail: your full Gmail address (e.g., hotel.reservations@gmail.com)
SMTP_USER=help.livinn@gmail.com

# App Password / SMTP Password
# IMPORTANT FOR GMAIL: Do not use your normal Google account password.
# Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification enabled)
SMTP_PASS=hkrj bsgf mxue ezsz

# Optional: Custom From Name/Address (defaults to "liv.inn Reservations <SMTP_USER>")
# SMTP_FROM="liv.inn Enquiries" <your-email@gmail.com>

# Hotel Staff Notification Recipient
# The email address of hotel staff where contact enquiries will be delivered
# Defaults to help.livinn@gmail.com if not specified
STAFF_RECEIVER_EMAIL=help.livinn@gmail.com
